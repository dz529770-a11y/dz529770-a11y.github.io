---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- assign entries = site.pages | concat: site.apps | sort: 'url' -%}
  {%- for item in entries -%}
    {%- unless item.sitemap == false or item.published == false -%}
      {%- assign ending = item.url | slice: -1, 1 -%}
      {%- assign extension = item.url | slice: -5, 5 -%}
      {%- if ending == '/' or extension == '.html' %}
  <url><loc>{{ item.url | absolute_url | xml_escape }}</loc></url>
      {%- endif -%}
    {%- endunless -%}
  {%- endfor %}
</urlset>

